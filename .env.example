# =====================================================================
# LaLiga Match Intelligence & Analytics Platform - Environment Configuration
# Duplicate this file to '.env' and populate with your credentials.
# =====================================================================

# 1. Football Data API (Striker API)
# Register at https://strikerapi.com to obtain your API key.
STRIKER_API_KEY=sk_live_your_striker_api_key_here

# 2. League & Season Parameters
LALIGA_SEASON=2026
LALIGA_LEAGUE=laliga

# 3. TheSportsDB API (Player Imagery & Cutouts)
# Use the free public testing key (123) or your Patreon key.
THESPORTSDB_API_KEY=123

# 4. Microsoft SQL Server Database Configuration
DB_SERVER=localhost
DB_NAME=SpainLeague
DB_DRIVER=ODBC Driver 17 for SQL Server

# Optional: Provide SQL authentication credentials (leave blank for Windows Trusted Authentication)
DB_USER=
DB_PASSWORD=

